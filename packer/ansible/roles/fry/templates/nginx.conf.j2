# nginx config rendered by the fry role at instance launch time.
# Variables injected via EC2 userdata → /etc/nginx-fry-vars.env → Ansible.
server {
    listen       80 default_server;
    server_name  {{ server_name }};
    root         /usr/share/nginx/html;
    index        index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Health check endpoint for the ALB target group
    location /health {
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Expose environment name for debugging (remove in production)
    location /env {
        return 200 "{{ environment }}\n";
        add_header Content-Type text/plain;
    }
}
